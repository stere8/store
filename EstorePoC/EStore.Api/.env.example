DATABASE_URL=Host=<aiven-host>;Port=<aiven-port>;Database=defaultdb;Username=<user>;Password=<password>;SSL Mode=Require;Maximum Pool Size=5
DATABASE_PROVIDER=postgres
SEED_DEMO_DATA=false
ADMIN_EMAIL=<your-admin-email>
ADMIN_LOGIN_CODE=<private-code-at-least-8-characters>
ADMIN_TOKEN_SECRET=<random-secret-at-least-32-UTF8-bytes>
ADMIN_TENANT_ID=kigali-city-mall
CLERK_JWT_ISSUER=https://<your-instance>.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=https://<storefront-origin>,http://localhost:3000
# Optional Clerk PEM public key; otherwise use issuer JWKS.
# CLERK_JWT_KEY=<PEM-public-key>
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
CLOUDINARY_UPLOAD_FOLDER=estore/products
